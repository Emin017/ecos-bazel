module(
    name = "ecos-bazel",
    version = "0.1.0",
)

bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.11")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi_autopatchelf",
    python_version = "3.11",
    requirements_lock = "//tools/auto-patchelf:requirements.txt",
)
use_repo(pip, "pypi_autopatchelf")

# PDK dependencies
icsprout55_pdk = use_extension("//rules:icsprout55_pdk.bzl", "icsprout55_pdk")
icsprout55_pdk.configure(enable_proxy = True)  # Optional: enable proxy for download
use_repo(icsprout55_pdk, "icsprout55_pdk")
